<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        The backend URL is entered by the user and normally points at a
        self-hosted server on a private network, for example
        http://192.168.1.10:8080. Android blocks cleartext HTTP by default,
        which made every such backend unreachable (the app only worked against
        loopback/emulator hosts), so plain HTTP is permitted here. HTTPS is
        still validated against the system trust anchors.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>