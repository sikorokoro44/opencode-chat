# opencode-chat backend configuration.
#
# Copy to `.env` (or export these) and fill in real values. Never commit a real
# `.env`. Every value below is read once at startup by `src/config.ts`.
#
# Generate the secrets with, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --------------------------------------------------------------------- runtime

# production | staging | development | test. Production refuses dev secrets.
NODE_ENV=development

# Interface and port the HTTP server binds to.
HOST=0.0.0.0
PORT=8080

# true | false. Rate limiting keys on the socket address unless this is true, in
# which case `X-Forwarded-For` is honoured. Only set it when a proxy you control
# terminates every request and *overwrites* that header: if a client can reach the
# backend directly, or the proxy appends to the header instead of replacing it, a
# caller can forge an address and mint unlimited rate-limit buckets.
TRUST_PROXY=false

# debug | info | warn | error | silent
LOG_LEVEL=debug

# Directory for the JSON collections and attachment blobs.
DATABASE_DIR=./data

# ---------------------------------------------------------------------- secrets
# Required in every environment. At least 32 characters.
OPENCODE_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Access token lifetime (seconds, 60..86400) and refresh token lifetime (300..31536000).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# One-time token required to authorise privileged coding-agent writes against
# GitHub. Leave empty to disable the privileged write API.
OPENCODE_ADMIN_BOOTSTRAP_TOKEN=

# 32-byte key, hex encoded (64 hex chars), used to encrypt stored GitHub tokens
# at rest. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENCODE_GITHUB_TOKEN_ENCRYPTION_KEY=

# Server-side GitHub token used for privileged coding-agent operations (gh CLI
# style, needs `repo` scope). Optional: users can connect their own token instead.
OPENCODE_GITHUB_TOKEN=

# ---------------------------------------------------------------- model providers
# The backend proxies to OpenAI-compatible chat completions endpoints. Keys stay
# here; they are never sent to the Android client.
OPENCODE_ZEN_API_KEY=
OPENCODE_OPENROUTER_API_KEY=
# Optional custom/self-hosted provider (e.g. Ollama, vLLM).
OPENCODE_CUSTOM_API_KEY=

# Provider base URLs override (rarely needed).
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENCODE_CUSTOM_BASE_URL=http://127.0.0.1:11434/v1

# Per-request provider timeout and maximum fallback attempts.
PROVIDER_TIMEOUT_MS=60000
MAX_FALLBACK_DEPTH=4

# ----------------------------------------------------------------- GitHub API
# Override for GitHub Enterprise or tests.
# OPENCODE_GITHUB_API_BASE_URL=https://api.github.com
# Path in each connected repo where project memory is stored.
OPENCODE_GITHUB_MEMORY_PATH=.opencode/PROJECT_MEMORY.md

# ------------------------------------------------------------------- limits
# Requests per minute per client and auth attempts per minute per identity.
REQUESTS_PER_MINUTE=120
AUTH_ATTEMPTS_PER_MINUTE=10

# Attachment limits in bytes (attachments vs. images only).
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_MAX_IMAGE_BYTES=3145728

# Hard cap on JSON request bodies; also bounds base64 attachment uploads.
MAX_REQUEST_BODY_BYTES=12582912

# SSE keep-alive comment interval (ms).
STREAM_HEARTBEAT_MS=15000
